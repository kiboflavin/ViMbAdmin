<form action="{genUrl controller="user" action="change-password"}"
      method="{$element->getMethod()}"
      enctype="{$element->getAttrib('enctype')}"
      id="{$element->getId()}"
      class="form-horizontal"
      name="{if $element->getName() != ''}{$element->getName()}{else}{$element->getId()}{/if}"
      {if $element->getAttrib('target')}target="{$element->getAttrib('target')}"{/if}
>

    {include file='form/element-input.phtml' ielement=$element->current_password}
    {include file='form/element-input.phtml' ielement=$element->password}
    <div class="control-group">
        <div class="controls">
            <button type="button" class="btn btn-small" onclick="generateSecurePassword()">
                <i class="icon-refresh"></i> Generate Secure Password
            </button>
            <span id="generated-password-display" class="help-inline" style="display: none;"></span>
        </div>
    </div>
    {include file='form/element-input.phtml' ielement=$element->confirm_password}

    {if !isset($modal) || !$modal}
        <fieldset class="form-actions">
            <input type="submit" class="btn btn-primary" value="Change My Password" />
        </fieldset>
    {/if}
</form>

<script type="text/javascript">
function generateSecurePassword() {
    const length = 16;
    const charset = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&*()_+-=[]{}|;:,.<>?';
    let password = '';
    
    // Ensure at least one of each character type
    password += 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'[Math.floor(Math.random() * 26)];
    password += 'abcdefghijklmnopqrstuvwxyz'[Math.floor(Math.random() * 26)];
    password += '0123456789'[Math.floor(Math.random() * 10)];
    password += '!@#$%^&*()_+-=[]{}|;:,.<>?'[Math.floor(Math.random() * 29)];
    
    // Fill the rest randomly
    for (let i = 4; i < length; i++) {
        password += charset[Math.floor(Math.random() * charset.length)];
    }
    
    // Shuffle the password
    password = password.split('').sort(() => Math.random() - 0.5).join('');
    
    // Set the password fields
    document.getElementById('password').value = password;
    document.getElementById('confirm_password').value = password;
    
    // Show the generated password to the user
    const display = document.getElementById('generated-password-display');
    display.textContent = 'Generated: ' + password;
    display.style.display = 'inline';
}
</script>
